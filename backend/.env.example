# Application Configuration
PORT=5000
NODE_ENV=development

# Database Setup (Docker Default)
DATABASE_URL="postgresql://postgres:password123@localhost:5432/prime_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_access_secret_key_change_this"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_change_this"
JWT_REFRESH_EXPIRES_IN="7d"

# Caching (Docker Default)
REDIS_URL="redis://localhost:6379"

# CORS Client Settings
CORS_ORIGIN="http://localhost:5173"
